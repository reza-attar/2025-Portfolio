# Contact form (src/features/contact). Copy to .env.local and fill in.

# Postgres connection string (Neon: Vercel → Storage → Neon, or neon.tech).
# Then run: bun run db:migrate
DATABASE_URL=

# Resend API key (resend.com → API Keys). The sending domain must be verified in Resend.
RESEND_API_KEY=

# Where notifications go, and who they come from (must be on the verified domain)
CONTACT_TO_EMAIL=contact@rezaattar.dev
CONTACT_FROM_EMAIL="Portfolio contact <noreply@rezaattar.dev>"

# Any random string; salts the IP hash used for rate limiting
CONTACT_IP_SALT=
